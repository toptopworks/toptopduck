{
  "name": "toptopduck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "i18n:extract": "formatjs extract \"src/**/*.tsx\" \"src/**/*.ts\" --format simple --out-file src/locales/en-US.json",
    "i18n:check": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt --check",
    "rust:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "rust:clippy:fix": "cd src-tauri && cargo clippy --fix --allow-dirty --all-targets",
    "rust:test": "cd src-tauri && cargo test",
    "check:all": "npm run build && npm run lint -- --max-warnings 0 && npm run i18n:check && npm run design:lint && npm test && npm run rust:fmt:check && npm run rust:clippy && npm run rust:test",
    "fix:all": "npm run format && npm run rust:fmt && npm run rust:clippy:fix && npm run rust:clippy",
    "design:lint": "designmd lint DESIGN.md",
    "knip": "knip",
    "jscpd": "jscpd"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intl": "^10.1.15",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.12",
    "@google/design.md": "^0.4.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jscpd": "^5.0.0",
    "jsdom": "^29.0.0",
    "knip": "^6.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
